{
  "name": "ghl-site-build",
  "private": true,
  "description": "Build tooling for the static site. Not published; node_modules is ignored.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css-src/tailwind.css -o ../css/tw.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i css-src/tailwind.css -o ../css/tw.css --watch"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "simple-icons": "^13.21.0",
    "tailwindcss": "3.4.17"
  }
}
